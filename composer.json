{
    "name": "zana/ddd",
    "description": "Domain-Driven Design building blocks for Zana applications",
    "type": "library",
    "keywords": ["zana", "ddd", "domain", "cqrs", "entity", "aggregate", "value-object"],
    "license": "MIT",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Zana\\Ddd\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zana\\Ddd\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

