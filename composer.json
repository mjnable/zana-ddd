{
    "name": "mj-zana/ddd",
    "description": "Domain-Driven Design and CQRS building blocks for Zana applications",
    "type": "library",
    "keywords": ["zana", "ddd", "domain", "cqrs", "entity", "aggregate", "value-object", "uuid"],
    "license": "MIT",
    "require": {
        "php": "^8.5"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Zana\\Ddd\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zana\\Ddd\\Tests\\": "tests/"
        },
        "files": ["tests/Fixtures.php"]
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
